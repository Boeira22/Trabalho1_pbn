{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build bagunceitor",
            "type": "shell",
            "command": "mingw32-make",
            "options": {
                "cwd": "${workspaceFolder}/bagunceitor"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run bagunceitor (predio32)",
            "type": "shell",
            "command": ".\\bagunceitor.exe",
            "args": [".\\predio32.jpg"],
            "options": {
                "cwd": "${workspaceFolder}/bagunceitor"
            },
            "dependsOn": "Build bagunceitor",
            "problemMatcher": []
        }
    ]
}